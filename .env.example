# FleetPay / Autocab
AUTOCAB_API_KEY=replace_with_rotated_key
AUTOCAB_COMPANY_ID=1
# Keep false until you have tested a 1p adjustment from Settings > Integrations.
AUTOCAB_ADJUSTMENTS_ENABLED=false

# Server / admin
PORT=3001
PORTAL_TOKEN_SECRET=replace_with_a_long_random_secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
DEV_AUTH_CODES=true

# Optional email delivery via Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=FleetPay <payments@example.com>

# Stripe TEST mode first. Use sk_test_... and Stripe CLI webhook secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://localhost:5173

# Wise Business sandbox demo
WISE_ENV=sandbox
WISE_API_TOKEN=
WISE_PROFILE_ID=

# Web Push / PWA notifications
# Generate after npm install with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
